# Base de datos PostgreSQL
DATABASE_URL=postgres://flota:flota@localhost:5432/flota
# Crea/actualiza tablas automáticamente (solo desarrollo / MVP)
DB_SYNC=true
# Secreto para firmar tokens JWT (cámbialo en producción)
JWT_SECRET=cambia-este-secreto
JWT_EXPIRES_IN=7d
# Puerto HTTP de la API y del websocket
PORT=3000
# Puerto TCP donde escuchan los GPS TK103 (Coban/Xexun)
TK103_PORT=5001
# IP o dominio público que se programa en los GPS por SMS
PUBLIC_HOST=mi-servidor.com
# APN por defecto para los SMS de configuración (Telcel: internet.itelcel.com)
DEFAULT_APN=internet.itelcel.com
# Token compartido para recibir posiciones reenviadas por Traccar (opcional)
TRACCAR_FORWARD_TOKEN=
# Usuario super administrador creado por `npm run seed`
SEED_ADMIN_EMAIL=admin@flota.local
SEED_ADMIN_PASSWORD=admin123
