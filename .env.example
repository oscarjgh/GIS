# Copia este archivo a .env y ajusta los valores antes de `docker compose up`.
DB_PASSWORD=flota
JWT_SECRET=pon-aqui-un-secreto-largo
# IP pública o dominio del servidor (se programa en los GPS por SMS)
PUBLIC_HOST=mi-servidor.com
# Solo para HTTPS (perfil "https"): dominio de la web y puerto interno de la web
#DOMAIN=flota.midominio.com
#WEB_PORT=8080
DEFAULT_APN=internet.itelcel.com
# Necesario solo si usas Traccar (perfil "traccar")
TRACCAR_FORWARD_TOKEN=pon-aqui-otro-secreto
SEED_ADMIN_EMAIL=admin@flota.local
SEED_ADMIN_PASSWORD=admin123
